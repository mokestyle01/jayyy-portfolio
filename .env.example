# Your live site URL — set this in Vercel Environment Variables for accurate SEO & link previews.
# Example: https://jayyy-portfolio.vercel.app
# If unset, Vercel auto-detects your deployment URL at build time.
NEXT_PUBLIC_SITE_URL=

# Form provider: mailto | formspree | emailjs
NEXT_PUBLIC_FORM_PROVIDER=mailto

# Formspree — https://formspree.io
# Endpoint format: https://formspree.io/f/YOUR_FORM_ID
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# EmailJS — https://www.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
